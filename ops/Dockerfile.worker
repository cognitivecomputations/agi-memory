# syntax=docker/dockerfile:1.7@sha256:a57df69d0ea827fb7266491f2813635de6f17269be881f696fbfdf2d83dda33e
FROM python:3.12-slim@sha256:09f7da3bc104798d0afb40bc08d23ab2da20a76130cec1f2ef170848f5d85217

# Pin uv itself as well as the dependency graph. The digest is the official
# multi-platform 0.12.7 image index (amd64 + arm64), matching publish.yml.
COPY --from=ghcr.io/astral-sh/uv:0.12.7@sha256:95f2aa1fe59274951cfe9b0cbc7972e879ff1004bc8945d130a32eb0dbd85945 /uv /uvx /bin/

WORKDIR /app

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PATH="/app/.venv/bin:$PATH" \
    UV_HTTP_RETRIES=5 \
    UV_HTTP_TIMEOUT=120 \
    UV_LINK_MODE=copy \
    UV_NO_PROGRESS=1 \
    UV_PYTHON_DOWNLOADS=never

# Dependency layer: uv.lock is the authority. --locked fails if pyproject.toml
# and the committed graph disagree; retries/timeouts make a slow index slow,
# never a reason to fall back into fresh dependency resolution.
COPY pyproject.toml uv.lock /app/
RUN --mount=type=cache,target=/root/.cache/uv \
    uv sync --locked --no-install-project

# Code layer: editable install so the live package IS /app — `docker compose
# watch` syncs source edits straight into the container and a restart picks
# them up, no rebuild. db/ ships too so workers apply pending migrations on
# startup (core/migrations.py resolves /app/db/migrations).
COPY README.md /app/README.md
COPY apps /app/apps
COPY core /app/core
COPY services /app/services
COPY channels /app/channels
COPY plugins /app/plugins
COPY skills /app/skills
COPY schemas /app/schemas
COPY db /app/db
COPY ops /app/ops
COPY characters /app/characters
RUN --mount=type=cache,target=/root/.cache/uv \
    uv sync --locked

# Build stamp (#93): content-derived, so clean builds of the same source agree
# while any code or locked-dependency change journals a new running build.
RUN find README.md pyproject.toml uv.lock apps core services channels plugins skills schemas db ops characters \
        -type f -print0 \
    | sort -z \
    | xargs -0 sha256sum \
    | sha256sum \
    | cut -d ' ' -f1 > /app/.build_id

CMD ["hexis-worker"]
