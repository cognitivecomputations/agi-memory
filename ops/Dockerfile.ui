FROM node:20-slim AS builder
# Prisma needs openssl present to detect the right query-engine target
# (without it, generate silently falls back to the openssl-1.1.x engine).
RUN apt-get update -y \
    && apt-get install -y --no-install-recommends openssl \
    && rm -rf /var/lib/apt/lists/*
WORKDIR /app
COPY hexis-ui/package.json hexis-ui/bun.lock* ./
RUN npm install --legacy-peer-deps --ignore-scripts
COPY hexis-ui/ .
COPY services/prompts/ /services/prompts/
COPY characters/ /characters/
ENV HEXIS_PROMPTS_DIR=/services/prompts
ENV HEXIS_CHARACTERS_DIR=/characters
RUN npx prisma generate && npm run build

FROM node:20-slim
# libssl is required at runtime by the Prisma query engine.
RUN apt-get update -y \
    && apt-get install -y --no-install-recommends openssl \
    && rm -rf /var/lib/apt/lists/*
WORKDIR /app
ENV NODE_ENV=production
ENV HEXIS_PROMPTS_DIR=/services/prompts
ENV HEXIS_CHARACTERS_DIR=/characters
COPY --from=builder /app/.next/standalone ./
COPY --from=builder /app/.next/static ./.next/static
COPY --from=builder /app/public ./public
COPY --from=builder /services/prompts /services/prompts
COPY --from=builder /characters /characters
EXPOSE 3477
ENV PORT=3477
CMD ["node", "server.js"]
