{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/QuixiAI/Hexis/evals/memory_benchmark/adapter-input.schema.v1.json",
  "title": "Hexis Public Memory Benchmark v1 adapter input",
  "type": "object",
  "additionalProperties": false,
  "required": ["benchmark", "version", "case_id", "dimension", "topic", "description", "events", "query", "response_contract"],
  "properties": {
    "benchmark": {"const": "hexis-public-memory-benchmark"},
    "version": {"const": "1.0.0"},
    "case_id": {"type": "string", "minLength": 1},
    "dimension": {
      "enum": [
        "provenance_accuracy",
        "contradiction_detection",
        "six_month_recall",
        "cross_session_continuity",
        "stale_belief_resistance"
      ]
    },
    "topic": {"type": "string", "minLength": 1},
    "description": {"type": "string", "minLength": 1},
    "events": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/event"}
    },
    "query": {"$ref": "#/$defs/query"},
    "response_contract": {
      "type": "object",
      "additionalProperties": {"type": "string"},
      "required": ["answer", "citations", "contradictions", "abstained"]
    }
  },
  "$defs": {
    "event": {
      "type": "object",
      "additionalProperties": false,
      "required": ["event_id", "session_id", "at", "kind", "content", "source"],
      "properties": {
        "event_id": {"type": "string", "minLength": 1},
        "session_id": {"type": "string", "minLength": 1},
        "at": {"type": "string", "format": "date-time"},
        "kind": {"enum": ["remember", "correct"]},
        "content": {"type": "string", "minLength": 1},
        "source": {"type": "object", "required": ["kind"], "additionalProperties": true},
        "supersedes": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        }
      }
    },
    "query": {
      "type": "object",
      "additionalProperties": false,
      "required": ["session_id", "at", "text"],
      "properties": {
        "session_id": {"type": "string", "minLength": 1},
        "at": {"type": "string", "format": "date-time"},
        "text": {"type": "string", "minLength": 1}
      }
    }
  }
}
